{
  "manifest_version": 3,
  "name": "Call Your AI",
  "version": "1.1",
  "description": "Access AI services directly from the Chrome address bar",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*"
  ],
  "omnibox": {
    "keyword": "@"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Open Call Your AI popup"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/store/icon16.png",
    "48": "icons/store/icon48.png",
    "128": "icons/store/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/store/icon16.png",
      "48": "icons/store/icon48.png",
      "128": "icons/store/icon128.png"
    }
  }
}
